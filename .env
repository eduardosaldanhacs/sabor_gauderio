# ------------------------------------------------------
# 🏷️ Aplicação
# ------------------------------------------------------
APP_NAME="Rodizio404"
APP_ENV=local
APP_KEY=base64:nOuAAZ42ngErKPbIE8JCJenMH+bv7vys58REpM/u+JI=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# ------------------------------------------------------
# 🔑 Segurança e autenticação
# ------------------------------------------------------
# Gere uma nova chave após criar o .env:
# php artisan key:generate
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------
# 🗂️ Logs
# ------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------
# 🛢️ Banco de dados
# ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rodizio_404
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------
# 📦 Cache e sessão
# ------------------------------------------------------
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ------------------------------------------------------
# 🔔 Broadcasting / filas / cache
# ------------------------------------------------------
BROADCAST_CONNECTION=log
CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------
# 📧 Email
# ------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------
# ☁️ AWS (caso use storage s3)
# ------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------
# 🧩 Front-end
# ------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
